<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The system draws its own splash before a single line of our code runs, and it uses
      the launcher icon on a default background. Unstyled, that showed a pale flash and a
      stray icon a moment before the FLOP launch scene appeared - which read as the app
      starting twice. Styling it to Base with the Chip makes the system's frame and our
      first frame the same picture, so the seam disappears.
    -->
    <style name="Theme.FlopPassport.Splash" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowSplashScreenBackground">@color/flop_base</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/flop_chip</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/flop_base</item>
        <item name="android:windowBackground">@color/flop_base</item>
        <item name="android:statusBarColor">@color/flop_base</item>
        <item name="android:navigationBarColor">@color/flop_base</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.FlopPassport" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/flop_base</item>
        <item name="android:statusBarColor">@color/flop_base</item>
        <item name="android:navigationBarColor">@color/flop_base</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
